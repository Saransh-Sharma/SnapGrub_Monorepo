# Root development notes only. Do not place real secrets in this file.
SNAPGRUB_ENV=dev

# Mobile uses anon public values only.
SUPABASE_URL=https://your-dev-project.supabase.co
SUPABASE_ANON_KEY=replace-with-dev-anon-key

# Server-only values belong in Supabase/Vercel environment settings, not in mobile.
SUPABASE_SERVICE_ROLE_KEY=server-only-do-not-ship-to-mobile
