{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snapgrub.app/schemas/EditableMealDraft.schema.json",
  "title": "EditableMealDraft",
  "type": "object",
  "required": ["title", "meal_type", "logged_at", "timezone", "total", "confidence", "components", "provenance"],
  "properties": {
    "title": { "type": "string" },
    "meal_type": { "type": "string", "enum": ["breakfast", "lunch", "dinner", "snack", "unknown"] },
    "logged_at": { "type": "string", "format": "date-time" },
    "timezone": { "type": "string" },
    "total": {
      "type": "object",
      "required": ["calories_kcal", "protein_g", "carbs_g", "fat_g"],
      "properties": {
        "calories_kcal": { "type": "number", "minimum": 0 },
        "protein_g": { "type": "number", "minimum": 0 },
        "carbs_g": { "type": "number", "minimum": 0 },
        "fat_g": { "type": "number", "minimum": 0 }
      }
    },
    "confidence": {
      "type": "object",
      "required": ["overall", "item_identification", "portion_estimation", "nutrition_source_quality", "warnings"],
      "properties": {
        "overall": { "type": "number", "minimum": 0, "maximum": 1 },
        "item_identification": { "type": "number", "minimum": 0, "maximum": 1 },
        "portion_estimation": { "type": "number", "minimum": 0, "maximum": 1 },
        "nutrition_source_quality": { "type": "number", "minimum": 0, "maximum": 1 },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "message", "severity"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "severity": { "type": "string", "enum": ["info", "review", "high"] }
            }
          }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "MealItemWrite.schema.json" }
    },
    "alternatives": { "type": "array", "items": { "type": "object" } },
    "provenance": { "type": "object" }
  }
}
