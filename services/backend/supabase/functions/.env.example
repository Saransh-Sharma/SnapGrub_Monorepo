# Copy this file to .env for local Supabase Edge Function runs.
# Do not commit real provider API keys.

CORS_ALLOW_ORIGIN=http://localhost:3000
AI_PROVIDER=mock

# Real providers. AI_PROVIDER=gemini|openai turns on model-backed photo, text,
# voice and conversation parsing; mock uses the offline rule parser.
# GEMINI_API_KEY=
# GEMINI_PRIMARY_MODEL=gemini-3.1-flash-lite
# AGENT_MODEL=gemini-3.1-flash-lite
# OPENAI_API_KEY=
# OPENAI_FALLBACK_MODEL=gpt-4.1-mini
# OPENAI_TEXT_MODEL=gpt-4.1-mini

# Model calls allowed per user per UTC day, across all modes.
# AI_DAILY_CALL_LIMIT=100
# Used to estimate cost in model_invocations.
# AI_INPUT_PRICE_PER_1M=0.25
# AI_OUTPUT_PRICE_PER_1M=1.50

# Generated meal artwork: images allowed per user per UTC day, and the price
# of one image for cost estimates.
# AI_DAILY_IMAGE_LIMIT=20
# AI_IMAGE_PRICE_USD=

# Kill switch: returns text, voice and chat to the rule parser. Photo
# analysis is unaffected.
# MEAL_TEXT_MODEL=off
